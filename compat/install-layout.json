        {
          "channel": "insiders",
          "product": "Antigravity - Insiders",
          "root": "/Applications/Antigravity - Insiders.app/Contents",
          "executable": "MacOS/Antigravity - Insiders"
        },
        {
          "channel": "antigravity",
          "product": "Antigravity",
          "root": "/Applications/Antigravity.app/Contents",
          "executable": "MacOS/Antigravity"
        }
      ]
    },
    "linux": {
      "resources": "resources",
      "language_server": "language_server",
