{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["electron"],
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "verbatimModuleSyntax": true
  },
  "include": ["runtime/**/*.ts"]
}
