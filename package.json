{
  "name": "agyctl",
  "version": "0.1.0",
  "description": "agyctl - Native Sidecar Plugin for real-time context window and generation speed monitoring via local Connect-RPC.",
  "type": "module",
  "scripts": {
    "test": "npm run test:prepare -s && npm run test:run -s",
    "test:localization": "npm run localization:build -s && npm run test:localization:run -s",
    "test:unit": "node --test tests/node/monitor-core.test.mjs tests/node/transport.test.mjs tests/node/locale.test.mjs tests/node/usage.test.mjs tests/node/pricing.test.mjs tests/node/runtime.test.mjs tests/node/install-safety.test.mjs",
    "test:electron": "node --test tests/electron/localization/runner.test.mjs tests/electron/capsule/runner.test.mjs",
    "test:vendor-sync": "npm run localization:build -s && npm run test:vendor-sync:run -s",
    "lint": "biome ci --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "plugin:install": "node scripts/plugin-install.mjs",
    "capsule:build": "node scripts/capsule-build.mjs",
    "capsule:typecheck": "tsc -p tsconfig.capsule.json",
    "capsule:install": "npm run host:build -s && node scripts/capsule-install.mjs",
    "capsule:uninstall": "npm run host:build -s && node scripts/capsule-uninstall.mjs",
    "host:build": "node src/host/esbuild.mjs",
    "host:typecheck": "tsc -p src/host/tsconfig.node.json --noEmit",
    "localization:build": "node src/localization/esbuild.mjs",
    "localization:typecheck": "tsc -p src/localization/tsconfig.node.json --noEmit && tsc -p src/localization/tsconfig.host.json --noEmit",
    "host-patch": "npm run host:build -s && node scripts/host-patch.mjs",
    "localization": "npm run localization:build -s && node scripts/localization.mjs",
    "limit:patch": "node scripts/agyctl.mjs limit patch",
    "limit:status": "node scripts/agyctl.mjs limit status",
    "limit:restore": "node scripts/agyctl.mjs limit restore",
    "limit:versions": "node scripts/agyctl.mjs limit versions",
    "update-check:versions": "node scripts/agyctl.mjs check versions",
    "update-check:local": "node scripts/agyctl.mjs check local",
    "update-check:check": "node scripts/agyctl.mjs check check",
    "update-check:files": "node scripts/agyctl.mjs check files",
    "update-check:report": "node scripts/agyctl.mjs check report",
    "tools:build": "node scripts/tools-build.mjs",
    "tools:test": "go -C src/agyctl test ./...",
    "tools:vet": "go -C src/agyctl vet ./...",
    "tools:lint": "cd src/agyctl && golangci-lint run",
    "typecheck": "tsc -p tsconfig.json",
    "test:prepare": "npm run host:build -s && npm run capsule:build -s",
    "test:run": "node --test tests/node/monitor-core.test.mjs tests/node/transport.test.mjs tests/node/capsule-anchors.test.mjs tests/node/runtime.test.mjs tests/node/locale.test.mjs tests/node/locale-state.test.mjs tests/node/usage.test.mjs tests/node/pricing.test.mjs tests/node/limit-diagnostics.test.mjs tests/node/install-paths.test.mjs tests/node/install-safety.test.mjs tests/node/host-patch.test.mjs",
    "test:localization:run": "node --test tests/node/localization.test.mjs tests/node/localization-logging.test.mjs tests/node/localization-vendor.test.mjs tests/node/runtime-startup.test.mjs",
    "test:vendor-sync:run": "node --test tests/node/localization-vendor-sync.test.mjs"
  },
  "keywords": [
    "antigravity",
    "context-window",
    "sidecar",
    "tokens",
    "metrics"
  ],
  "author": "Antigravity Pair",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@types/node": "^26.6.6",
    "acorn": "8.19.0",
    "electron": "44.10.2",
    "esbuild": "0.28.2",
    "intl-messageformat": "12.1.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^26.13.0"
  }
}
